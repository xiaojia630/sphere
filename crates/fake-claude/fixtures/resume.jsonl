// Fresh: starts and waits for a long time. Resumed (after the host lost it):
// reports its arguments and the "continue" message it was given.
{"op":"init"}
{"op":"wait_user"}
{"mode":"fresh","op":"say_args"}
{"mode":"fresh","op":"say","text":"starting"}
{"mode":"fresh","op":"tool","name":"Read","input":{"file_path":"README.md"},"result":"hello"}
{"mode":"fresh","op":"sleep","ms":600000}
{"mode":"resume","op":"say_args"}
{"mode":"resume","op":"say_user","prefix":"resumed with: "}
{"op":"result","text":"resumed ok","cost":0.03}
