#!/bin/sh
# A stand-in `docker` for the README clips: a small compose project named "demo" (cache, db, mail running, worker exited).
# It answers only what Sphere asks: ps, stats, logs, events.
case "$1" in
ps)
    if [ "$4" = "{{.State}}" ]; then printf 'running\nrunning\nrunning\nexited\n'; exit 0; fi
    cat <<'J'
{"ID":"d9a4f0e8d6a1","Names":"demo-cache","Image":"redis:7-alpine","State":"running","Status":"Up About a minute","Ports":"0.0.0.0:16379->6379/tcp","Labels":"com.docker.compose.project=demo,com.docker.compose.service=cache"}
{"ID":"3a2f5c0e8b11","Names":"demo-db","Image":"postgres:16","State":"running","Status":"Up About a minute","Ports":"0.0.0.0:15432->5432/tcp","Labels":"com.docker.compose.project=demo,com.docker.compose.service=db"}
{"ID":"13fe6d4e9b07","Names":"demo-mail","Image":"axllent/mailpit","State":"running","Status":"Up About a minute (healthy)","Ports":"0.0.0.0:18025->8025/tcp, 1025/tcp","Labels":"com.docker.compose.project=demo,com.docker.compose.service=mail"}
{"ID":"53a6a4bd0c9e","Names":"demo-worker","Image":"redis:7-alpine","State":"exited","Status":"Exited (0) About a minute ago","Ports":"","Labels":"com.docker.compose.project=demo,com.docker.compose.service=worker"}
J
    ;;
stats)
    cat <<'J'
{"ID":"d9a4f0e8d6a1","CPUPerc":"0.42%","MemUsage":"4.9MiB / 7.8GiB","MemPerc":"0.06%"}
{"ID":"3a2f5c0e8b11","CPUPerc":"1.85%","MemUsage":"32.4MiB / 7.8GiB","MemPerc":"0.41%"}
{"ID":"13fe6d4e9b07","CPUPerc":"0.27%","MemUsage":"8.1MiB / 7.8GiB","MemPerc":"0.10%"}
J
    ;;
logs)
    for id; do :; done
    t=2026-10-19T13:33
    case "$id" in
    d9a4*|demo-cache) cat <<J
$t:02.118Z 1:C 19 Oct 2026 13:33:02.118 * oO0OoO0OoO0Oo Redis is starting oO0OoO0OoO0Oo
$t:02.118Z 1:C 19 Oct 2026 13:33:02.118 * Redis version=7.4.1, bits=64, commit=00000000, modified=0, pid=1, just started
$t:02.119Z 1:M 19 Oct 2026 13:33:02.119 * monotonic clock: POSIX clock_gettime
$t:02.120Z 1:M 19 Oct 2026 13:33:02.120 * Running mode=standalone, port=6379.
$t:02.120Z 1:M 19 Oct 2026 13:33:02.120 * Server initialized
$t:02.121Z 1:M 19 Oct 2026 13:33:02.121 * Ready to accept connections tcp
J
    ;;
    3a2f*|demo-db) cat <<J
$t:03.402Z PostgreSQL init process complete; ready for start up.
$t:03.517Z 2026-10-19 13:33:03.517 UTC [1] LOG:  starting PostgreSQL 16.4 (Debian 16.4-1.pgdg120+2) on aarch64-unknown-linux-gnu
$t:03.518Z 2026-10-19 13:33:03.518 UTC [1] LOG:  listening on IPv4 address "0.0.0.0", port 5432
$t:03.518Z 2026-10-19 13:33:03.518 UTC [1] LOG:  listening on IPv6 address "::", port 5432
$t:03.521Z 2026-10-19 13:33:03.521 UTC [1] LOG:  listening on Unix socket "/var/run/postgresql/.s.PGSQL.5432"
$t:03.529Z 2026-10-19 13:33:03.529 UTC [62] LOG:  database system was shut down at 2026-10-19 13:33:03 UTC
$t:03.534Z 2026-10-19 13:33:03.534 UTC [1] LOG:  database system is ready to accept connections
J
    ;;
    13fe*|demo-mail) cat <<J
$t:02.640Z time="2026/10/19 13:33:02" level=info msg="[smtpd] starting on [::]:1025 (no encryption)"
$t:02.641Z time="2026/10/19 13:33:02" level=info msg="[http] starting on [::]:8025"
$t:02.641Z time="2026/10/19 13:33:02" level=info msg="[http] accessible via http://localhost:8025/"
J
    ;;
    *) cat <<J
$t:04.010Z 1:C 19 Oct 2026 13:33:04.010 * Redis version=7.4.1, bits=64, commit=00000000, modified=0, pid=1, just started
$t:04.012Z 1:M 19 Oct 2026 13:33:04.012 * Server initialized
$t:41.877Z 1:signal-handler (1760880821) Received SIGTERM scheduling shutdown...
$t:41.978Z 1:M 19 Oct 2026 13:33:41.978 * DB saved on disk
$t:41.979Z 1:M 19 Oct 2026 13:33:41.979 # Redis is now ready to exit, bye bye...
J
    ;;
    esac
    ;;
events) exec sleep 86400 ;;
*) echo "demo docker: $1 isn't part of the demo" >&2; exit 1 ;;
esac
